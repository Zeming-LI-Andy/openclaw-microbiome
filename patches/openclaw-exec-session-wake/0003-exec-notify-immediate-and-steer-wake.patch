new file mode 100644
index 00000000000..cc77aea56f2
--- /dev/null
+++ b/src/agents/bash-tools.exec-notify-wake.ts
@@ -0,0 +1,119 @@
+// Wakes the owning session after a background exec exits.
+// Idle sessions use an immediate heartbeat; active sessions get steered mid-turn.
+import {
+  type EventSessionRoutingPolicy,
+  resolveEventSessionKeyForPolicy,
+  scopedHeartbeatWakeOptionsForPolicy,
+} from "../infra/event-session-routing.js";
+import { requestHeartbeat } from "../infra/heartbeat-wake.js";
+import { enqueueSystemEvent } from "../infra/system-events.js";
+import { logWarn } from "../logger.js";
+import { isSubagentSessionKey } from "../sessions/session-key-utils.js";
+import type { DeliveryContext } from "../utils/delivery-context.shared.js";
+import type { EmbeddedAgentQueueMessageOptions } from "./embedded-agent-runner/run-state.js";
+import {
+  isEmbeddedAgentRunActive,
+  queueEmbeddedAgentMessageWithOutcomeAsync,
+  resolveActiveEmbeddedRunSessionId,
+} from "./embedded-agent-runner/runs.js";
+
+export type ExecNotifyWakeDeps = {
+  resolveActiveSessionId: (sessionKey: string) => string | undefined;
+  isSessionRunActive: (sessionId: string) => boolean;
+  queueSteerMessage: (
+    sessionId: string,
+    text: string,
+    options?: EmbeddedAgentQueueMessageOptions,
+  ) => Promise<{ queued: boolean }>;
+  enqueueSystemEvent: typeof enqueueSystemEvent;
+  requestHeartbeat: typeof requestHeartbeat;
+};
+
+const defaultDeps: ExecNotifyWakeDeps = {
+  resolveActiveSessionId: resolveActiveEmbeddedRunSessionId,
+  isSessionRunActive: isEmbeddedAgentRunActive,
+  queueSteerMessage: queueEmbeddedAgentMessageWithOutcomeAsync,
+  enqueueSystemEvent,
+  requestHeartbeat,
+};
+
+let execNotifyWakeDeps: ExecNotifyWakeDeps = defaultDeps;
+
+/** Test-only dependency override for notify wake routing. */
+export function setExecNotifyWakeDepsForTest(deps: Partial<ExecNotifyWakeDeps> | null): void {
+  execNotifyWakeDeps = deps ? { ...defaultDeps, ...deps } : defaultDeps;
+}
+
+function buildExecCompletionSteerMessage(eventText: string): string {
+  return (
+    "An async command you ran earlier has completed. The command completion details are:\n\n" +
+    eventText +
+    "\n\nContinue in this same turn: inspect the result, use tools if needed, and reply with " +
+    "progress or next steps."
+  );
+}
+
+function requestExecCompletionHeartbeat(params: {
+  sessionKey: string;
+  eventRouting?: EventSessionRoutingPolicy;
+}): void {
+  execNotifyWakeDeps.requestHeartbeat(
+    scopedHeartbeatWakeOptionsForPolicy(
+      params.sessionKey,
+      {
+        source: "exec-event",
+        intent: "immediate",
+        reason: "exec-event",
+        coalesceMs: 0,
+      },
+      params.eventRouting,
+    ),
+  );
+}
+
+/**
+ * Deliver an exec-exit wake: steer into an active turn when possible, otherwise
+ * enqueue a system event and request an immediate heartbeat for a fresh turn.
+ */
+export async function wakeSessionAfterExecExit(params: {
+  sessionKey: string;
+  eventText: string;
+  eventRouting?: EventSessionRoutingPolicy;
+  deliveryContext?: DeliveryContext;
+}): Promise<"steered" | "heartbeat" | "skipped"> {
+  const sessionKey = params.sessionKey.trim();
+  if (!sessionKey || isSubagentSessionKey(sessionKey)) {
+    return "skipped";
+  }
+  const wakeSessionKey = resolveEventSessionKeyForPolicy(sessionKey, params.eventRouting);
+  const activeSessionId = execNotifyWakeDeps.resolveActiveSessionId(wakeSessionKey);
+  if (activeSessionId && execNotifyWakeDeps.isSessionRunActive(activeSessionId)) {
+    try {
+      const outcome = await execNotifyWakeDeps.queueSteerMessage(
+        activeSessionId,
+        buildExecCompletionSteerMessage(params.eventText),
+        {
+          steeringMode: "all",
+          waitForTranscriptCommit: true,
+        },
+      );
+      if (outcome.queued) {
+        return "steered";
+      }
+    } catch (error) {
+      logWarn(
+        `exec: active-session steer after exit failed (${String(error)}); falling back to heartbeat.`,
+      );
+    }
+  }
+
+  execNotifyWakeDeps.enqueueSystemEvent(params.eventText, {
+    sessionKey: wakeSessionKey,
+    deliveryContext: params.deliveryContext,
+  });
+  requestExecCompletionHeartbeat({
+    sessionKey: wakeSessionKey,
+    eventRouting: params.eventRouting,
+  });
+  return "heartbeat";
+}
diff --git a/src/agents/bash-tools.exec-notify-wake.test.ts b/src/agents/bash-tools.exec-notify-wake.test.ts
