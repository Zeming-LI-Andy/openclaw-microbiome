@@ -0,0 +1,114 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  setExecNotifyWakeDepsForTest,
+  wakeSessionAfterExecExit,
+} from "./bash-tools.exec-notify-wake.js";
+
+describe("wakeSessionAfterExecExit", () => {
+  afterEach(() => {
+    setExecNotifyWakeDepsForTest(null);
+  });
+
+  it("requests an immediate heartbeat when the session is idle", async () => {
+    const enqueueSystemEvent = vi.fn();
+    const requestHeartbeat = vi.fn();
+    setExecNotifyWakeDepsForTest({
+      resolveActiveSessionId: () => undefined,
+      isSessionRunActive: () => false,
+      queueSteerMessage: vi.fn(async () => ({ queued: false })),
+      enqueueSystemEvent,
+      requestHeartbeat,
+    });
+
+    await expect(
+      wakeSessionAfterExecExit({
+        sessionKey: "agent:main:dashboard:demo",
+        eventText: "Exec completed (brisk-otter, code 0) :: DONE",
+      }),
+    ).resolves.toBe("heartbeat");
+
+    expect(enqueueSystemEvent).toHaveBeenCalledWith(
+      "Exec completed (brisk-otter, code 0) :: DONE",
+      expect.objectContaining({ sessionKey: "agent:main:dashboard:demo" }),
+    );
+    expect(requestHeartbeat).toHaveBeenCalledWith(
+      expect.objectContaining({
+        source: "exec-event",
+        intent: "immediate",
+        reason: "exec-event",
+        coalesceMs: 0,
+        sessionKey: "agent:main:dashboard:demo",
+      }),
+    );
+  });
+
+  it("steers into an active session turn instead of heartbeating", async () => {
+    const enqueueSystemEvent = vi.fn();
+    const requestHeartbeat = vi.fn();
+    const queueSteerMessage = vi.fn(async () => ({ queued: true }));
+    setExecNotifyWakeDepsForTest({
+      resolveActiveSessionId: () => "session-active",
+      isSessionRunActive: (sessionId) => sessionId === "session-active",
+      queueSteerMessage,
+      enqueueSystemEvent,
+      requestHeartbeat,
+    });
+
+    await expect(
+      wakeSessionAfterExecExit({
+        sessionKey: "agent:main:dashboard:demo",
+        eventText: "Exec completed (brisk-otter, code 0) :: DONE",
+      }),
+    ).resolves.toBe("steered");
+
+    expect(queueSteerMessage).toHaveBeenCalledWith(
+      "session-active",
+      expect.stringContaining("Exec completed (brisk-otter, code 0) :: DONE"),
+      expect.objectContaining({ steeringMode: "all", waitForTranscriptCommit: true }),
+    );
+    expect(enqueueSystemEvent).not.toHaveBeenCalled();
+    expect(requestHeartbeat).not.toHaveBeenCalled();
+  });
+
+  it("falls back to immediate heartbeat when steer does not queue", async () => {
+    const enqueueSystemEvent = vi.fn();
+    const requestHeartbeat = vi.fn();
+    setExecNotifyWakeDepsForTest({
+      resolveActiveSessionId: () => "session-active",
+      isSessionRunActive: () => true,
+      queueSteerMessage: vi.fn(async () => ({ queued: false })),
+      enqueueSystemEvent,
+      requestHeartbeat,
+    });
+
+    await expect(
+      wakeSessionAfterExecExit({
+        sessionKey: "agent:main:main",
+        eventText: "Exec failed (x, code 1)",
+      }),
+    ).resolves.toBe("heartbeat");
+
+    expect(requestHeartbeat).toHaveBeenCalledWith(
+      expect.objectContaining({ intent: "immediate", reason: "exec-event" }),
+    );
+  });
+
+  it("skips subagent session keys", async () => {
+    const enqueueSystemEvent = vi.fn();
+    const requestHeartbeat = vi.fn();
+    setExecNotifyWakeDepsForTest({
+      enqueueSystemEvent,
+      requestHeartbeat,
+    });
+
+    await expect(
+      wakeSessionAfterExecExit({
+        sessionKey: "agent:main:subagent:child-1",
+        eventText: "Exec completed (x, code 0)",
+      }),
+    ).resolves.toBe("skipped");
+
+    expect(enqueueSystemEvent).not.toHaveBeenCalled();
+    expect(requestHeartbeat).not.toHaveBeenCalled();
+  });
+});
